{
  "schema_version": 1,
  "artifact": "H3-R2-transition-sequence-contract",
  "marker": "H3-R2.2.1",
  "policy": {
    "qualified_kill_ms": 500,
    "watchdog_service_period_ms": 500,
    "anti_auto_start": "The safety controller keeps SAFETY_FAULT_REQUEST asserted until self-test passes and RUN_EDGE has remained low continuously for 500 ms. RC timing is debounce and observability, not the sole safety barrier.",
    "hard_fault": "Any POR, watchdog, physical KILL/open-loop or safety fault clears RUN_PERMIT asynchronously without firmware grace.",
    "fault_display": "S3 is not tied to the generic fault-reset sinks. It remains available for a fault-only UI while 3V3_MAIN is valid; Safety may independently pulse S3 reset through PA23 and M1 contact 36.",
    "rearm": "A cleared latch cannot restart from USB attach, software reset or fault recovery while the switch remains RUN. A fresh qualified KILL followed by a physical KILL-to-RUN edge is mandatory."
  },
  "required_endpoints": {
    "power_command_switch.THROW_A": "RUN_LOOP_RAW",
    "power_command_switch.COMMON": "POWER_GROUND",
    "power_command_switch.THROW_B": "POWER_COMMAND_OFF_N",
    "safe_conditioner.1A": "RUN_LOOP_RAW",
    "safe_conditioner.1Y": "RUN_EDGE",
    "safe_rearm_delay_res.END_1": "RUN_EDGE",
    "safe_rearm_delay_res.END_2": "SAFE_REARM_DELAY",
    "safe_rearm_delay_cap.END_1": "SAFE_REARM_DELAY",
    "safe_rearm_delay_cap.END_2": "POWER_GROUND",
    "safe_rearm_buffer.A": "SAFE_REARM_DELAY",
    "safe_rearm_buffer.Y": "SAFE_REARM_CLK",
    "safe_latch.CLK": "SAFE_REARM_CLK",
    "safe_latch.D": "SAFE_D_HIGH",
    "safe_latch.Q": "RUN_PERMIT",
    "safe_latch.Q_N": "FAULT_KILL",
    "safe_latch.CLR_N": "SAFE_CLEAR_N",
    "safe_latch.PRE_N": "AON_SAFE_3V3",
    "safe_latch_d_pullup.END_1": "AON_SAFE_3V3",
    "safe_latch_d_pullup.END_2": "SAFE_D_HIGH",
    "safe_gate_b.3A": "POR_N",
    "safe_gate_b.3B": "FAULT_ASSERT_N",
    "safe_gate_b.3Y": "SAFE_CLEAR_N",
    "safe_supervisor.RESET_N": "POR_N",
    "safe_supervisor.SENSE": "AON_SAFE_3V3",
    "safe_supervisor.CT": null,
    "safety_watchdog.WDO_N": "FAULT_ASSERT_N",
    "safety_controller.PA6": "SAFETY_WATCHDOG_WDI",
    "safety_controller.PA23": "S3_FAULT_RESET_REQUEST",
    "safety_controller.PA24": "RUN_EDGE",
    "safety_controller.PA25": "SAFETY_FAULT_REQUEST",
    "safety_fault_request_pulldown.END_1": "SAFETY_FAULT_REQUEST",
    "safety_fault_request_pulldown.END_2": "POWER_GROUND",
    "safety_fault_request_iso.A": "SAFETY_FAULT_REQUEST",
    "safety_fault_request_iso.Y": "FAULT_ASSERT_N",
    "safe_run_fault_iso.A": "RUN_EDGE",
    "safe_run_fault_iso.Y": "FAULT_ASSERT_N",
    "safety_s3_reset_pulldown.END_1": "S3_FAULT_RESET_REQUEST",
    "safety_s3_reset_pulldown.END_2": "POWER_GROUND",
    "safety_s3_reset_iso.A": "S3_FAULT_RESET_REQUEST",
    "safety_s3_reset_iso.Y": "S3_RESET_KILL_GATE",
    "m1_rf_receptacle.P36": "S3_RESET_KILL_GATE",
    "m1_ui_plug.P36": "S3_RESET_KILL_GATE",
    "s3_reset_gate_pullup.END_1": "3V3_MAIN",
    "s3_reset_gate_pullup.END_2": "S3_RESET_KILL_GATE",
    "safe_reset_sink_a.G1": "S3_RESET_KILL_GATE",
    "safe_reset_sink_a.D1": "S3_RESET_N",
    "safe_c5_fault_reset_buffer.A": "FAULT_ASSERT_N",
    "safe_c5_fault_reset_buffer.Y": "C5_RESET_N",
    "safe_fault_reset_buffer.1A": "FAULT_ASSERT_N",
    "safe_fault_reset_buffer.1Y": "RF_RP_RESET_N",
    "safe_reset_sink_b.D1": "RF_RP_RESET_N"
  },
  "required_net_members": {
    "FAULT_KILL": [
      "safe_latch.Q_N",
      "m1_rf_receptacle.P35",
      "m1_ui_plug.P35",
      "fault_led_series.END_1"
    ],
    "S3_RESET_KILL_GATE": [
      "safety_s3_reset_iso.Y",
      "m1_rf_receptacle.P36",
      "m1_ui_plug.P36",
      "s3_reset_gate_pullup.END_2",
      "safe_reset_sink_a.G1"
    ],
    "FAULT_ASSERT_N": [
      "safety_fault_request_iso.Y",
      "safe_run_fault_iso.Y",
      "safety_watchdog.WDO_N",
      "safe_gate_b.3B",
      "safe_c5_fault_reset_buffer.A",
      "safe_fault_reset_buffer.1A"
    ],
    "RUN_PERMIT": [
      "safe_latch.Q",
      "safe_reset_buffer.A",
      "safe_c5_reset_buffer.A",
      "m1_rf_receptacle.P37",
      "m1_ui_plug.P37"
    ]
  },
  "scenarios": [
    {
      "id": "SEQ-01",
      "title": "Cold start with switch at KILL",
      "events": ["power_on_kill", "por_valid", "self_test_pass", "hold_kill_500", "switch_run", "rc_clock"],
      "expected_final": {"permit": true, "firmware_state": "RUNNING", "hazardous_enabled": true}
    },
    {
      "id": "SEQ-02",
      "title": "Cold start with switch already at RUN",
      "events": ["power_on_run", "por_valid", "self_test_pass", "rc_clock"],
      "expected_final": {"permit": false, "firmware_state": "WAIT_KILL", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-03",
      "title": "RUN-at-boot followed by explicit KILL and RUN",
      "events": ["power_on_run", "por_valid", "self_test_pass", "rc_clock", "switch_kill", "hold_kill_500", "switch_run", "rc_clock"],
      "expected_final": {"permit": true, "firmware_state": "RUNNING", "hazardous_enabled": true}
    },
    {
      "id": "SEQ-04",
      "title": "Insufficient KILL dwell",
      "events": ["power_on_kill", "por_valid", "self_test_pass", "hold_kill_short", "switch_run", "rc_clock"],
      "expected_final": {"permit": false, "firmware_state": "WAIT_KILL", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-05",
      "title": "Switch bounce fails closed",
      "events": ["power_on_kill", "por_valid", "self_test_pass", "hold_kill_500", "switch_run", "switch_kill", "switch_run", "rc_clock"],
      "expected_final": {"permit": false, "firmware_state": "WAIT_KILL", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-06",
      "title": "Physical KILL or open loop during RUN",
      "events": ["normal_start", "switch_kill"],
      "expected_final": {"permit": false, "firmware_state": "WAIT_KILL", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-07",
      "title": "Watchdog timeout and automatic WDO recovery",
      "events": ["normal_start", "watchdog_fault", "fault_recovers"],
      "expected_final": {"permit": false, "firmware_state": "FAULT_LATCHED", "hazardous_enabled": false, "s3_available": true}
    },
    {
      "id": "SEQ-08",
      "title": "Safety-controller reset during RUN",
      "events": ["normal_start", "safety_controller_reset"],
      "expected_final": {"permit": false, "firmware_state": "BOOT_HOLD_FAULT", "hazardous_enabled": false, "s3_available": true}
    },
    {
      "id": "SEQ-09",
      "title": "Fault recovery while switch remains RUN",
      "events": ["normal_start", "hard_fault", "fault_recovers", "rc_clock", "usb_attach"],
      "expected_final": {"permit": false, "firmware_state": "FAULT_LATCHED", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-10",
      "title": "Independent S3 fault-UI reset",
      "events": ["normal_start", "hard_fault", "pulse_s3_reset", "release_s3_reset"],
      "expected_final": {"permit": false, "firmware_state": "FAULT_LATCHED", "hazardous_enabled": false, "s3_available": true, "s3_reset_asserted": false}
    },
    {
      "id": "SEQ-11",
      "title": "AON undervoltage or POR assertion",
      "events": ["normal_start", "aon_undervoltage", "aon_recovers", "rc_clock"],
      "expected_final": {"permit": false, "firmware_state": "BOOT_HOLD_FAULT", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-12",
      "title": "Self-test failure",
      "events": ["power_on_kill", "por_valid", "self_test_fail", "hold_kill_500", "switch_run", "rc_clock"],
      "expected_final": {"permit": false, "firmware_state": "FAULT_LATCHED", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-13",
      "title": "USB attach cannot rearm a stopped product",
      "events": ["normal_start", "hard_fault", "usb_attach", "fault_recovers"],
      "expected_final": {"permit": false, "firmware_state": "FAULT_LATCHED", "hazardous_enabled": false}
    },
    {
      "id": "SEQ-14",
      "title": "Complete qualified recovery after fault",
      "events": ["normal_start", "hard_fault", "fault_recovers", "switch_kill", "hold_kill_500", "switch_run", "rc_clock"],
      "expected_final": {"permit": true, "firmware_state": "RUNNING", "hazardous_enabled": true}
    }
  ],
  "physical_residuals": [
    "H8 measures real switch bounce and break-before-make interval.",
    "H8 measures the populated 100-kohm/2.2-uF RC under DC bias and temperature; startup safety does not depend solely on this number.",
    "H8 captures POR assertion/release, direct C5/RF-RP reset and S3 fault-display retention at real rail corners."
  ],
  "authorization": {
    "analytical_verification": true,
    "firmware_emulation_contract": true,
    "pcb_placement_or_routing": false,
    "purchasing": false,
    "fabrication": false
  }
}

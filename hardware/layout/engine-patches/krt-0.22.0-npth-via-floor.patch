diff --git a/tests/test_npth_via_declared_floor.py b/tests/test_npth_via_declared_floor.py
new file mode 100644
index 0000000..8b825ff
--- /dev/null
+++ b/tests/test_npth_via_declared_floor.py
@@ -0,0 +1,184 @@
+#!/usr/bin/env python3
+"""Declared copper-to-NPTH clearance must cover via copper, not only drills.
+
+RF/UI coordinates reproduce two native KiCad hole_clearance failures from
+Leshy2. All fixtures are temporary, reduced boards; no corpus board is edited.
+Run with python3 tests/test_npth_via_declared_floor.py.
+"""
+import copy
+import json
+import math
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(ROOT / name) for name in ('py_router', 'py_tools')]
+
+from check_drc import run_drc
+from kicad_parser import parse_kicad_pcb
+from obstacle_map import GridObstacleMap, add_drill_hole_obstacles
+from pcb_modification import nudge_grazing_vias
+from routing_config import GridCoord, GridRouteConfig
+
+
+CASES = (
+    ('RF', (32.375, 27.75), 1.4, (31.55, 28.5), (31.2, 27.75),
+     0.21495515604888737),
+    ('UI', (56.6, 120.75), 0.7, (56.25, 121.45), (55.75, 120.75),
+     0.2326237921249264),
+)
+
+
+class DeclaredNPTHViaFloor(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.serial = 0
+
+    def fixture(self, hole=(10., 10.), drill=1., via=(10.925, 10.),
+                floor=.25, origin=None, local=0., plated=False, foreign=''):
+        self.serial += 1
+        path = Path(self.tmp.name) / f'case-{self.serial}.kicad_pcb'
+        hx, hy = hole
+        vx, vy = via
+        distance = math.hypot(vx - hx, vy - hy)
+        ex, ey = vx + (vx - hx) / distance, vy + (vy - hy) / distance
+        pad_type = 'thru_hole' if plated else 'np_thru_hole'
+        path.write_text(f'''(kicad_pcb (version 20221018)
+ (net 0 "") (net 1 "SIG") (net 2 "FOREIGN")
+ (gr_rect (start 0 0) (end 100 140) (layer "Edge.Cuts") (width 0.1))
+ (footprint "test:hole" (layer "F.Cu") (at {hx} {hy})
+  (property "Reference" "H1" (at 0 -2) (layer "F.SilkS"))
+  (pad "" {pad_type} circle (at 0 0) (size {drill} {drill})
+   (drill {drill}) (layers "*.Cu" "*.Mask") (clearance {local})))
+ (via (at {vx} {vy}) (size 0.4) (drill 0.2)
+  (layers "F.Cu" "B.Cu") (net 1) (uuid "via"))
+ (segment (start {vx} {vy}) (end {ex} {ey}) (width 0.15)
+  (layer "F.Cu") (net 1) (uuid "anchor"))
+ {foreign}
+)''')
+        rules = {} if floor is None else {'min_hole_clearance': floor}
+        project = {'board': {'design_settings': {'rules': rules}}}
+        if origin is not None:
+            project['kicad_routing_tools'] = {
+                'fab_floor_origin': {'min_hole_clearance': origin}}
+        path.with_suffix('.kicad_pro').write_text(json.dumps(project))
+        return path
+
+    @staticmethod
+    def config(explicit=0.):
+        return GridRouteConfig(layers=['F.Cu', 'B.Cu'], grid_step=.025,
+                               track_width=.15, clearance=.16, via_size=.4,
+                               via_drill=.2, hole_to_hole_clearance=.25,
+                               hole_clearance=explicit)
+
+    def blocked(self, path, explicit=0.):
+        pcb = parse_kicad_pcb(str(path))
+        via = pcb.vias.pop()  # its own drill must not mask the NPTH probe
+        cfg = self.config(explicit)
+        obs = GridObstacleMap(2)
+        add_drill_hole_obstacles(obs, pcb, cfg, {1})
+        return obs.is_via_blocked(*GridCoord(cfg.grid_step).to_grid(via.x, via.y))
+
+    @staticmethod
+    def graded(path, explicit=0.):
+        return [item for item in run_drc(
+            str(path), clearance=.16, hole_to_hole_clearance=.25,
+            hole_clearance=explicit, clearance_margin=0., quiet=True,
+            print_summary=False, check_sizes=False) if item['type'] == 'via-hole']
+
+    def nudge(self, path, explicit=0., allowed=True, cap=.05):
+        pcb = parse_kicad_pcb(str(path))
+        via = pcb.vias[0]
+        start = (via.x, via.y)
+        before_segments = copy.deepcopy(pcb.segments)
+        moved, _, _ = nudge_grazing_vias(
+            [{'new_vias': [via] if allowed else []}], pcb, {1},
+            clearance=.16, hole_to_hole=.25, max_shift=cap,
+            config=self.config(explicit))
+        self.assertEqual(pcb.segments, before_segments)
+        shift = math.hypot(via.x - start[0], via.y - start[1])
+        self.assertLessEqual(shift, min(cap, via.size / 4) + 1e-4)
+        pad = pcb.footprints['H1'].pads[0]
+        gap = math.hypot(via.x - pad.global_x, via.y - pad.global_y)
+        gap -= (via.size + pad.drill) / 2
+        return moved, gap, shift
+
+    def test_real_rf_and_ui_coordinates(self):
+        for name, hole, drill, near, far, original_gap in CASES:
+            with self.subTest(board=name):
+                path = self.fixture(hole, drill, near)
+                measured = math.dist(hole, near) - drill / 2 - .2
+                self.assertAlmostEqual(measured, original_gap, places=9)
+                self.assertGreater(measured + .1, .25)  # drill rule already clear
+                self.assertTrue(self.blocked(path))
+                items = self.graded(path)
+                self.assertEqual(len(items), 1)
+                self.assertEqual(items[0]['required_mm'], .25)
+                moved, gap, shift = self.nudge(path)
+                self.assertEqual(moved, 1)
+                self.assertGreaterEqual(gap, .25)
+                self.assertLess(shift, .05)
+                # A cell beyond the declared floor stays routable and untouched.
+                clear = self.fixture(hole, drill, far)
+                self.assertFalse(self.blocked(clear))
+                self.assertEqual(self.graded(clear), [])
+                self.assertEqual(self.nudge(clear)[0], 0)
+
+    def test_original_floor_survives_relaxed_project(self):
+        path = self.fixture(floor=.16, origin=.25)
+        self.assertTrue(self.blocked(path))
+        self.assertEqual(self.graded(path)[0]['required_mm'], .25)
+        self.assertGreaterEqual(self.nudge(path)[1], .25)
+
+    def test_max_of_local_and_declared_floor(self):
+        for floor, local, vx, required in (
+                (.25, .19, 10.925, .25),
+                (.25, .25, 10.925, .25),
+                (.25, .30, 10.975, .30),
+                (None, .19, 10.875, .19),
+                (None, .20, 10.875, .20)):
+            with self.subTest(floor=floor, local=local):
+                path = self.fixture(via=(vx, 10.), floor=floor, local=local)
+                self.assertTrue(self.blocked(path))
+                self.assertEqual(self.graded(path)[0]['required_mm'], required)
+                moved, gap, _ = self.nudge(path)
+                self.assertEqual(moved, 1)
+                self.assertGreaterEqual(gap, required)
+
+    def test_explicit_config_floor(self):
+        path = self.fixture(via=(10.975, 10.), floor=None)
+        self.assertTrue(self.blocked(path, .30))
+        self.assertEqual(self.graded(path, .30)[0]['required_mm'], .30)
+        self.assertGreaterEqual(self.nudge(path, .30)[1], .30)
+
+    def test_no_declared_rule_does_not_import_track_policy(self):
+        path = self.fixture(via=(10.875, 10.), floor=None)
+        # Copper gap .175 clears .16; drill gap .275 clears .25. The .20
+        # track policy must not fabricate a via DRC failure or obstacle.
+        self.assertFalse(self.blocked(path))
+        self.assertEqual(self.graded(path), [])
+        self.assertEqual(self.nudge(path)[0], 0)
+
+    def test_plated_pad_keeps_existing_rule_path(self):
+        path = self.fixture(plated=True)
+        self.assertFalse(self.blocked(path))
+        self.assertEqual(self.graded(path), [])
+        self.assertEqual(self.nudge(path)[0], 0)
+
+    def test_nudge_preserves_scope_budget_and_foreign_copper(self):
+        path = self.fixture()
+        self.assertEqual(self.nudge(path, allowed=False)[0], 0)
+        self.assertEqual(self.nudge(path, cap=.01)[0], 0)
+        foreign = '''(segment (start 11.385 9) (end 11.385 11) (width 0.15)
+ (layer "F.Cu") (net 2) (uuid "foreign"))'''
+        boxed = self.fixture(foreign=foreign)
+        moved, gap, shift = self.nudge(boxed)
+        self.assertEqual((moved, shift), (0, 0))
+        self.assertLess(gap, .25)  # leave unrepairable violation visible
+
+
+if __name__ == '__main__':
+    unittest.main()

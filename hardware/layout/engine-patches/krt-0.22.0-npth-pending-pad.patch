+"""Pure pending-pad lifecycle tests: fake maps, no route search or native DRC.
+
+Retirement deliberately tests the existing XY attachment/epoch heuristic,
+not electrical connectivity or native clearance authority.
+"""
+import copy
+from pathlib import Path
+import sys
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import Mock, patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(ROOT / "py_router"), str(ROOT / "py_tools"), str(ROOT)]
+import connectivity
+import env_knobs
+import kicad_parser
+import net_queries
+import obstacle_costs
+import routing_context
+from routing_config import GridCoord, GridRouteConfig
+
+
+class FakeMap:
+    def __init__(self):
+        self.batches = []
+        self.groups = []
+
+    def add_stub_proximity_costs_batch(self, points, radius, cost):
+        self.batches.append((list(points), radius, cost))
+
+    def add_stub_proximity_costs_grouped(self, groups, zones):
+        self.groups.append((copy.deepcopy(groups), zones))
+
+
+class PendingPadTests(unittest.TestCase):
+    def setUp(self):
+        for name, value in (("PENDING_PAD_PROTECTION", True), ("FINE_PITCH_PSEUDO_STUBS", False),
+                            ("PSEUDO_STUB_RETIRE", True), ("PROXIMITY_SUM", False),
+                            ("PROXIMITY_SUM_MODE", ""), ("STUB_LAYER_AWARE", False)):
+            guard = patch.object(env_knobs, name, value)
+            guard.start()
+            self.addCleanup(guard.stop)
+        guard = patch.object(kicad_parser, "detect_package_type", return_value="OTHER")
+        guard.start()
+        self.addCleanup(guard.stop)
+        # OTHER-class 11-pad B.Cu package, matching the relevant ESD class.
+        rows = [(1, 0), (1, 2), (1, 4), (2, 6), (2, 7), (3, 8)]
+        rows += [(0, x) for x in (10, 12, 14, 16, 18)]
+        pads = [NS(net_id=nid, global_x=x, global_y=0, size_x=.2, size_y=.5,
+                   layers=["B.Cu"], rotation=90, drill=0) for nid, x in rows]
+        self.main = NS(net_id=1, start_x=0, start_y=0, end_x=2, end_y=0,
+                       width=.15, layer="B.Cu")
+        self.pcb = NS(footprints={"U5": NS(pads=pads)}, segments=[self.main], vias=[],
+                      _copper_epoch=1, pads_by_net={nid: [p for p in pads if p.net_id == nid]
+                                                 for nid in (0, 1, 2, 3)})
+        self.cfg = GridRouteConfig(grid_step=.05, track_width=.15, clearance=.16,
+                                   via_size=.4, via_drill=.2, layers=["F.Cu", "B.Cu"])
+        self.coord = GridCoord(self.cfg.grid_step)
+
+    def pending(self, owner=3):
+        return routing_context._pending_pad_nets([1, 2, 3], [1, 2, 3, 99], [owner])
+
+    def query(self, ids=(1,), **kwargs):
+        return net_queries.get_chip_pad_positions(self.pcb, list(ids), **kwargs)
+
+    def test_default_off_excludes_pending_and_preserves_historical_stamp(self):
+        with patch.object(env_knobs, "PENDING_PAD_PROTECTION", False):
+            pending = self.pending()
+        self.assertEqual([], pending)
+        legacy, explicit = FakeMap(), FakeMap()
+        points = [(9, 1, "B.Cu")]
+        with patch.object(net_queries, "get_chip_pad_positions") as query:
+            obstacle_costs.apply_stub_proximity(legacy, self.pcb, [], points, self.cfg)
+            obstacle_costs.apply_stub_proximity(explicit, self.pcb, [], points, self.cfg,
+                                               pending_pad_net_ids=pending)
+        query.assert_not_called()
+        self.assertEqual(legacy.batches, explicit.batches)
+        self.assertEqual(legacy.groups, explicit.groups)
+
+    def test_pending_intersection_is_sorted_unique_and_excludes_owners(self):
+        self.assertEqual([1, 2], self.pending())
+        self.assertEqual([1], routing_context._pending_pad_nets([3, 1, 1, 2], [9, 3, 1, 2], [2, 3]))
+        self.assertEqual([], routing_context._pending_pad_nets([1], [2], []))
+
+    def test_phase1_main_does_not_retire_its_unattached_leaf(self):
+        self.assertIn(1, self.pending())
+        self.assertEqual([(4, 0, "B.Cu")], self.query(require_unescaped=True))
+        with patch.object(env_knobs, "PSEUDO_STUB_RETIRE", False):
+            self.assertEqual(3, len(self.query()))
+            self.assertEqual([(4, 0, "B.Cu")], self.query(require_unescaped=True))
+
+    def test_copper_epoch_retires_attached_leaf_and_rip_restores_it(self):
+        self.assertEqual([(4, 0, "B.Cu")], self.query(require_unescaped=True))
+        tap = NS(net_id=1, start_x=2, start_y=0, end_x=4, end_y=0, width=.15, layer="B.Cu")
+        self.pcb.segments.append(tap)
+        self.pcb._copper_epoch += 1
+        self.assertEqual([], self.query(require_unescaped=True))
+        self.pcb.segments.remove(tap)
+        self.pcb._copper_epoch += 1
+        self.assertEqual([(4, 0, "B.Cu")], self.query(require_unescaped=True))
+
+    def test_package_filter_and_grouped_empty_type_remain_explicit(self):
+        with patch.object(env_knobs, "FINE_PITCH_PSEUDO_STUBS", True):
+            self.assertEqual([], self.query(require_unescaped=True))
+            self.assertEqual({}, self.query(require_unescaped=True, group_by_net=True))
+        self.assertEqual({1: [(4, 0, "B.Cu")], 2: [(6, 0, "B.Cu"), (7, 0, "B.Cu")]},
+                         self.query((1, 2), require_unescaped=True, group_by_net=True))
+
+    def test_max_adds_only_pending_pads_without_mutating_inputs_or_copper(self):
+        obstacles = FakeMap()
+        stubs = [(20, 0, "B.Cu")]
+        geometry = copy.deepcopy((self.pcb.footprints, self.pcb.segments, self.pcb.vias))
+        with patch.object(connectivity, "get_stub_endpoints") as real_stubs, \
+                patch.object(net_queries, "get_chip_pad_positions", wraps=net_queries.get_chip_pad_positions) as query:
+            obstacle_costs.apply_stub_proximity(obstacles, self.pcb, [], stubs, self.cfg,
+                                               pending_pad_net_ids=[2, 1, 2])
+        query.assert_called_once_with(self.pcb, [1, 2], require_unescaped=True, group_by_net=True)
+        real_stubs.assert_not_called()
+        self.assertEqual([self.coord.to_grid(x, 0) for x in (20, 4, 6, 7)], obstacles.batches[0][0])
+        self.assertEqual(1, len(obstacles.batches))
+        self.assertEqual([], obstacles.groups)
+        self.assertEqual([(20, 0, "B.Cu")], stubs)
+        self.assertEqual(geometry, (self.pcb.footprints, self.pcb.segments, self.pcb.vias))
+
+    def test_sum_preserves_owner_groups_without_reintroducing_complete_stubs(self):
+        obstacles = FakeMap()
+        with patch.object(env_knobs, "PROXIMITY_SUM", True), \
+                patch.object(env_knobs, "PROXIMITY_SUM_MODE", "sum"), \
+                patch.object(connectivity, "get_stub_endpoints", return_value=[]) as real_stubs:
+            obstacle_costs.apply_stub_proximity(obstacles, self.pcb, [2], [], self.cfg,
+                                               pending_pad_net_ids=[2, 1, 1])
+        real_stubs.assert_called_once_with(self.pcb, [2])
+        self.assertEqual([], obstacles.batches)
+        groups, zones = obstacles.groups[0]
+        self.assertIsNone(zones)
+        self.assertEqual([[self.coord.to_grid(x, 0) for x in (6, 7)], [self.coord.to_grid(4, 0)]],
+                         [group[0] for group in groups])
+        self.assertTrue(all(group[2] == self.cfg.cell_cost(self.cfg.stub_proximity_cost) for group in groups))
+
+    def test_pending_protection_does_not_resurrect_routed_via_ghosts(self):
+        ghosts = {1: [(10, 10)], 99: [(30, 30)]}
+        filtered = routing_context.filter_ripped_ghosts(ghosts, self.cfg, [1, 2])
+        self.assertEqual({99: [(30, 30)]}, filtered)
+        obstacles = FakeMap()
+        obstacle_costs.apply_stub_proximity(obstacles, self.pcb, [], [], self.cfg,
+                                           ghost_via_groups=filtered, pending_pad_net_ids=[1])
+        self.assertEqual([[self.coord.to_grid(4, 0)], [(30, 30)]], [row[0] for row in obstacles.batches])
+        self.assertEqual({1: [(10, 10)], 99: [(30, 30)]}, ghosts)
+
+    def test_all_four_builders_pass_foreign_pending_ids(self):
+        class Captured(Exception):
+            pass
+        obstacles = Mock()
+        obstacles.clone_fresh.return_value = obstacles
+        routed, all_ids, layers = [1, 2, 3], [1, 2, 3, 4], {"F.Cu": 0, "B.Cu": 1}
+        calls = (
+            (routing_context.build_diff_pair_obstacles,
+             (obstacles, self.pcb, self.cfg, routed, [], all_ids, 2, 3, None, {}, layers, 0), [1]),
+            (routing_context.build_single_ended_obstacles,
+             (obstacles, self.pcb, self.cfg, routed, [], all_ids, 3, None, {}, layers), [1, 2]),
+            (routing_context.build_incremental_obstacles,
+             (obstacles, self.pcb, self.cfg, 3, all_ids, routed, {}, layers, {}), [1, 2]),
+            (routing_context.prepare_obstacles_inplace,
+             (obstacles, self.pcb, self.cfg, 3, all_ids, routed, {}, layers, {}), [1, 2]),
+        )
+        with patch.multiple(routing_context, add_net_stubs_as_obstacles=Mock(),
+                            add_net_vias_as_obstacles=Mock(), add_net_pads_as_obstacles=Mock(),
+                            get_stub_endpoints=Mock(return_value=[]), get_chip_pad_positions=Mock(return_value=[])), \
+                patch.object(routing_context, "apply_stub_proximity", side_effect=Captured) as apply:
+            for function, args, expected in calls:
+                with self.subTest(builder=function.__name__), self.assertRaises(Captured):
+                    function(*args)
+                self.assertEqual(expected, apply.call_args.kwargs["pending_pad_net_ids"])
+                self.assertEqual([4], apply.call_args.args[2])
+
+
+if __name__ == "__main__":
+    unittest.main()

  "engineering_target": {
    "manufacturer_mandated_max_trace_length_mm": null,
    "working_raw_pad_pair_target_mm": 10,
    "rationale": "A locality/planning target for reducing pickup area and keeping bias and switching points together, not a manufacturer limit or frequency-derived pass/fail threshold. The capsule has an internal FET and a 2.2-kohm load: it is not an unbuffered high-impedance electret element. An 80-mm trace alone is not proof of audio failure over the 100-Hz to 10-kHz capsule band.",
    "raw_route_requirements_still_open": [
      "Close AUDIO_GROUND return and a quiet reference plane/path.",
      "Separation from switching/RF/fast-digital routing when those remaining nets are actually routed.",
      "No long unused raw-signal stub; retain bias and switching within the intended island."
    ],
    "routing_length_distinction": "The capsule's centre land exits via the +Y gap in its ground annulus. Direct 5.203-mm pad distance is not the routed capsule-to-U85 distance; the verified scratch path is 14.527 mm."
  },

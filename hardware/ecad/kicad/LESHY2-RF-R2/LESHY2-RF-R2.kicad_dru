(version 1)

# Named edge components intentionally cross Edge.Cuts.  Ordinary copper retains
# the 0.20 mm board rule; this exception is not available to routed tracks.
(rule "RF named edge-mount copper"
  (condition "A.Reference == 'J1' || A.Reference == 'J4' || A.Reference == 'J5' || A.Reference == 'J6' || A.Reference == 'J7' || A.Reference == 'J8' || A.Reference == 'J9' || A.Reference == 'J11' || A.Reference == 'SW1' || A.Reference == 'SW2'")
  (constraint edge_clearance (min -3mm)))

(rule "RF USB and side-switch internal hole geometry"
  (condition "(A.Reference == 'J4' && B.Reference == 'J4') || (A.Reference == 'SW1' && B.Reference == 'SW1') || (A.Reference == 'SW2' && B.Reference == 'SW2')")
  (constraint hole_clearance (min 0.09mm)))

# GCT USB4105 B4 recommended layout: the two 0.65-mm locator holes have
# nominal 0.1944-mm clearance to their coincident A1/B12 and A12/B1 GND lands.
# Only RF J1's exact GCT package, NPTH locators and four GND pad numbers receive
# this 0.19-mm internal minimum. Other parts/tracks/pads retain the global rule.
# This preserves the nominal manufacturer pattern, not factory DFM qualification.
# KiCad 9 PCB Editor manual: custom rules / memberOfFootprint and Pad properties.
(rule "RF J1 exact GCT locator to GND internal hole geometry"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('J1') && B.memberOfFootprint('J1') && A.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal') && B.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal') && ((A.Pad_Type == 'NPTH, mechanical' && A.Pad_Number == '' && A.Hole_Size_X == 0.65mm && A.Hole_Size_Y == 0.65mm && B.Pad_Type == 'SMD' && (B.Pad_Number == 'A1' || B.Pad_Number == 'B12' || B.Pad_Number == 'A12' || B.Pad_Number == 'B1') && B.NetName == '/RF_01_USB_PD_CHARGE/POWER_GROUND') || (B.Pad_Type == 'NPTH, mechanical' && B.Pad_Number == '' && B.Hole_Size_X == 0.65mm && B.Hole_Size_Y == 0.65mm && A.Pad_Type == 'SMD' && (A.Pad_Number == 'A1' || A.Pad_Number == 'B12' || A.Pad_Number == 'A12' || A.Pad_Number == 'B1') && A.NetName == '/RF_01_USB_PD_CHARGE/POWER_GROUND'))")
  (constraint hole_clearance (min 0.19mm)))

# TI's REF0038A recommended land pattern has a 0.125 mm local gap between the
# two exposed power lands.  The exception is restricted to the single package.
(rule "TPS25751 REF0038A internal exposed-pad gap"
  (condition "A.Reference == 'U3' && B.Reference == 'U3'")
  (constraint clearance (min 0.12mm)))

(rule "RF edge-switch assembly silk"
  (severity ignore)
  (condition "A.Reference == 'SW1' || A.Reference == 'SW2'")
  (constraint silk_clearance))

# The interboard connector is on the inner face and the SMT battery holder is
# on the outer face.  J12's two empty locator holes pass through the board under
# the holder body without a protruding pin.
(rule "J12 locator holes under opposite-face battery holder"
  (condition "(A.Reference == 'J12' && B.Reference == 'BT1') || (A.Reference == 'BT1' && B.Reference == 'J12')")
  (constraint courtyard_clearance (min -1mm)))

# Generated H6 controlled-impedance rules.  Values are the exact current
# JLC06161H-3313 calculator result; recheck immediately before ordering.
(rule "H6 outer RF 50R CPWG 5.31mil width 6.00mil gap"
  (layer outer)
  (condition "A.Type == 'Track' && (A.NetName == '/RF_20_CC1101_VOICE_TX/CC_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_MID' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_TRAP' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_433_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_433_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_868_915_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_868_915_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_BAL_A' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_BAL_B' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_MATCH_MID' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_N' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_P' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SAMPLE' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SELECTED' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SWITCH_INPUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_UNBALANCED' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_U_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_U_RF_SAMPLE' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_V_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_V_RF_SAMPLE' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_IN_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_N1' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_N2' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_OUT_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S1_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S1_L_MID' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S2_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S3_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S3_L_MID' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_CONVERTED_RAW_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_CONVERTED_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_DIRECT_RAW_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_DIRECT_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LNA_IN_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LNA_OUT_BIASED' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_AC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_CLK_RAW' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_MATCHED' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_PAD' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_IN_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_IN_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_OUT_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_OUT_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_RX_SELECTED_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_SELECTOR_RFC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_PRI' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_CT' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T2_SEC_A' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T2_SEC_B' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_AMI_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_AMLW_BOUNDARY_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMI_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMSW_BOUNDARY_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMSW_MATCHED_RF')")
  (constraint track_width (min 5.31mil) (opt 5.31mil) (max 5.31mil))
  (constraint clearance (min 6.00mil)))

(rule "H6 outer USB 90R 5.31mil width 6.00mil gap"
  (layer outer)
  (condition "A.Type == 'Track' && (A.NetName == '/RF_01_USB_PD_CHARGE/S3_USB_N' || A.NetName == '/RF_01_USB_PD_CHARGE/S3_USB_P' || A.NetName == '/RF_01_USB_PD_CHARGE/USB2_CONNECTOR_N' || A.NetName == '/RF_01_USB_PD_CHARGE/USB2_CONNECTOR_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_CONNECTOR_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_CONNECTOR_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_SWITCHED_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_SWITCHED_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_USB_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_USB_P')")
  (constraint track_width (min 5.31mil) (opt 5.31mil) (max 5.31mil))
  (constraint diff_pair_gap (min 6.00mil) (opt 6.00mil) (max 6.00mil)))

# Only the exact edge-launch RF nets may cross Edge.Cuts and use one
# reviewed B.Cu-to-F.Cu signal via.  The manual-copper generator enforces
# the one-via count and exact 0.50/0.25-mm geometry.
(rule "H6 reviewed RF edge-launch trace reaches centre land"
  (condition "A.Type == 'Track' && (A.NetName == '/RF_20_CC1101_VOICE_TX/CC_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_U_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_V_EXTERNAL_RF_50R' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_AMLW_BOUNDARY_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMSW_BOUNDARY_RF')")
  (constraint edge_clearance (min -3mm)))

(rule "H6 controlled-impedance tracks stay on outer layers"
  (layer inner)
  (condition "A.Type == 'Track' && (A.NetName == '/RF_01_USB_PD_CHARGE/S3_USB_N' || A.NetName == '/RF_01_USB_PD_CHARGE/S3_USB_P' || A.NetName == '/RF_01_USB_PD_CHARGE/USB2_CONNECTOR_N' || A.NetName == '/RF_01_USB_PD_CHARGE/USB2_CONNECTOR_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_CONNECTOR_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_CONNECTOR_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_SWITCHED_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_SWITCHED_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_USB_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_USB_P' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_MID' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_TRAP' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_433_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_433_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_868_915_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_868_915_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_BAL_A' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_BAL_B' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_MATCH_MID' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_N' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_P' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SAMPLE' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SELECTED' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SWITCH_INPUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_UNBALANCED' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_U_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_U_RF_SAMPLE' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_V_EXTERNAL_RF_50R' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_V_RF_SAMPLE' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_IN_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_N1' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_N2' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_OUT_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S1_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S1_L_MID' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S2_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S3_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S3_L_MID' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_CONVERTED_RAW_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_CONVERTED_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_DIRECT_RAW_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_DIRECT_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LNA_IN_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LNA_OUT_BIASED' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_AC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_CLK_RAW' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_MATCHED' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_PAD' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_IN_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_IN_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_OUT_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_OUT_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_RX_SELECTED_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_SELECTOR_RFC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_PRI' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_CT' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T2_SEC_A' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T2_SEC_B' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_AMI_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_AMLW_BOUNDARY_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMI_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMSW_BOUNDARY_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMSW_MATCHED_RF')")
  (constraint disallow track))

(rule "H6 controlled-impedance vias only on reviewed edge launches"
  (condition "A.Type == 'Via' && (A.NetName == '/RF_01_USB_PD_CHARGE/S3_USB_N' || A.NetName == '/RF_01_USB_PD_CHARGE/S3_USB_P' || A.NetName == '/RF_01_USB_PD_CHARGE/USB2_CONNECTOR_N' || A.NetName == '/RF_01_USB_PD_CHARGE/USB2_CONNECTOR_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_CONNECTOR_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_CONNECTOR_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_SWITCHED_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_SERVICE_USB_SWITCHED_P' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_USB_N' || A.NetName == '/RF_10_RP2354_CORE_SERVICE/RF_RP_USB_P' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_MID' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_315_TRAP' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_433_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_433_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_868_915_IN' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_868_915_OUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_BAL_A' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_BAL_B' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_MATCH_MID' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_N' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_P' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SAMPLE' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SELECTED' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_SWITCH_INPUT' || A.NetName == '/RF_20_CC1101_VOICE_TX/CC_RF_UNBALANCED' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_U_RF_SAMPLE' || A.NetName == '/RF_20_CC1101_VOICE_TX/VOICE_V_RF_SAMPLE' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_IN_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_N1' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_N2' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_OUT_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S1_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S1_L_MID' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S2_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S3_LC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_BPF_S3_L_MID' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_CONVERTED_RAW_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_CONVERTED_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_DIRECT_RAW_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_DIRECT_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LNA_IN_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LNA_OUT_BIASED' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_AC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_CLK_RAW' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_MATCHED' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_LO_PAD' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_IN_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_IN_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_OUT_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_MIXER_OUT_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_RX_SELECTED_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_SELECTOR_RFC' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_PRI' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_CT' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_N' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T1_SEC_P' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T2_SEC_A' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/AIR_T2_SEC_B' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_AMI_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMI_RF' || A.NetName == '/RF_21_BROADCAST_AIRBAND_RX/RX_FMSW_MATCHED_RF')")
  (constraint disallow via))

(version 1)

# These named parts are deliberately mounted on a routed board edge.  Their
# manufacturer land patterns cross Edge.Cuts; all other copper keeps the normal
# 0.20 mm project clearance.
(rule "UI named edge-mount copper"
  (condition "A.Reference == 'D11' || A.Reference == 'J3' || A.Reference == 'J5' || A.Reference == 'J7' || A.Reference == 'J9' || A.Reference == 'J11' || A.Reference == 'J12' || A.Reference == 'J14' || A.Reference == 'J16' || A.Reference == 'SW18' || A.Reference == 'SW19'")
  (constraint edge_clearance (min -3mm)))

# Locator and retention holes are part of these manufacturer footprints.  Only
# same-footprint hole-to-pad checks receive the package-specific minimum.
(rule "UI USB and side-switch internal hole geometry"
  (condition "(A.Reference == 'J9' && B.Reference == 'J9') || (A.Reference == 'J11' && B.Reference == 'J11') || (A.Reference == 'SW1' && B.Reference == 'SW1') || (A.Reference == 'SW2' && B.Reference == 'SW2') || (A.Reference == 'SW18' && B.Reference == 'SW18') || (A.Reference == 'SW19' && B.Reference == 'SW19') || (A.Reference == 'SW20' && B.Reference == 'SW20') || (A.Reference == 'SW21' && B.Reference == 'SW21')")
  (constraint hole_clearance (min 0.09mm)))

(rule "UI edge-component assembly silk"
  (severity ignore)
  (condition "A.Reference == 'J5' || A.Reference == 'SW18' || A.Reference == 'SW19'")
  (constraint silk_clearance))

# Generated H6 controlled-impedance rules.  Values are the exact current
# JLC06161H-3313 calculator result; recheck immediately before ordering.
(rule "H6 outer RF 50R CPWG 5.31mil width 6.00mil gap"
  (layer outer)
  (condition "A.Type == 'Track' && (A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_COUPLER_TERMINATION' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_EXTERNAL_RF_50R' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_FORWARD_RF_SAMPLE' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_FORWARD_RF_SAMPLE_RAW' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_MODULE_RF_50R' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_COUPLER_TERMINATION' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_EXTERNAL_RF_50R' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_FORWARD_RF_SAMPLE' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_FORWARD_RF_SAMPLE_RAW' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_MODULE_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_EXTERNAL_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_FORWARD_RF_SAMPLE' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_MODULE_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_REVERSE_ISOLATED_PORT' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_EXTERNAL_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_FORWARD_RF_SAMPLE' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_MODULE_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_REVERSE_ISOLATED_PORT' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_EXTERNAL_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_FORWARD_RF_SAMPLE' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_MODULE_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_REVERSE_ISOLATED_PORT')")
  (constraint track_width (min 5.31mil) (opt 5.31mil) (max 5.31mil))
  (constraint clearance (min 6.00mil)))

(rule "H6 outer USB 90R 5.31mil width 6.00mil gap"
  (layer outer)
  (condition "A.Type == 'Track' && (A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_LOCAL_N' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_LOCAL_P' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_N' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_P' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_BRANCH_N' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_BRANCH_P' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_CONNECTOR_N' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_CONNECTOR_P' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_CONNECTOR_N' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_CONNECTOR_P' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_SWITCHED_N' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_SWITCHED_P' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_USB_N' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_USB_P')")
  (constraint track_width (min 5.31mil) (opt 5.31mil) (max 5.31mil))
  (constraint diff_pair_gap (min 6.00mil) (opt 6.00mil) (max 6.00mil)))

(rule "H6 controlled impedance stays on outer layers"
  (layer inner)
  (condition "(A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_COUPLER_TERMINATION' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_EXTERNAL_RF_50R' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_FORWARD_RF_SAMPLE' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_FORWARD_RF_SAMPLE_RAW' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_MODULE_RF_50R' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_LOCAL_N' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_LOCAL_P' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_N' || A.NetName == '/UI_10_S3_DISPLAY_TOUCH/S3_USB_P' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_COUPLER_TERMINATION' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_EXTERNAL_RF_50R' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_FORWARD_RF_SAMPLE' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_FORWARD_RF_SAMPLE_RAW' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_MODULE_RF_50R' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_BRANCH_N' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_BRANCH_P' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_CONNECTOR_N' || A.NetName == '/UI_20_C5_WIFI_IR_SERVICE/C5_SERVICE_USB_CONNECTOR_P' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_CONNECTOR_N' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_CONNECTOR_P' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_SWITCHED_N' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_SERVICE_USB_SWITCHED_P' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_USB_N' || A.NetName == '/UI_30_HUB_RP_CORE_SERVICE/HUB_RP_USB_P' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_EXTERNAL_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_FORWARD_RF_SAMPLE' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_MODULE_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF0_REVERSE_ISOLATED_PORT' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_EXTERNAL_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_FORWARD_RF_SAMPLE' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_MODULE_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF1_REVERSE_ISOLATED_PORT' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_EXTERNAL_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_FORWARD_RF_SAMPLE' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_MODULE_RF_50R' || A.NetName == '/UI_31_NRF24_X3_TX_EVIDENCE/NRF2_REVERSE_ISOLATED_PORT')")
  (constraint disallow track via))
